AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash
# Optional. Adds entries to the composer's model picker as `id|Label` pairs,
# comma separated. Built-in models are already listed; use this for vendor models
# whose key you bound in the console. One gateway key serves every entry, so this
# extends the choice of model, not the choice of provider.
# AI_GATEWAY_EXTRA_MODELS=deepseek/deepseek-v4-pro|DeepSeek V4 Pro
# Required. Master token, held in the Agent Runtime, which only mints
# short-lived per-project tenant tokens into direct sandbox CLI calls. Live
# preview and deploy both run the Makers CLI with it, as do credentialed
# backends such as Blob; unset, what is left is chat and a static preview.
API_TOKEN=
# Optional. Read by the web_search tool the CLI toolkit injects into the agent
# runtime, not by this project's own code. Left unset, the tool is withheld from
# the model entirely rather than offered and failed. Either way platform
# knowledge comes from the vendored skills, never from a search.
# WSA_API_KEY=
# Leave unset. Preview and deploy then use a project derived from the
# conversation, so later turns reach the same site and two users never collide
# over one name. Setting it pins every conversation to the project named here.
# MAKERS_DEPLOY_PROJECT_NAME=
